# Copy to .env and adjust for your environment
ENVIRONMENT=dev

SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=postgresql://fastapi_user:fastapi_password@localhost:5432/fastapi_db
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/0

DEBUG=True
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated or JSON array
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Email codes: "console" prints them in the logs, "smtp" sends real email.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=InsideHub <no-reply@insidehub.local>

# Link in the password-reset email. Point this at the React app.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# Writing assistant. Leave AI_BASE_URL empty for OpenAI.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_DRAFTS_PER_DAY=10
AI_CALLS_PER_DAY=30
# "Write about a news event" toggle. Needs a provider with a built-in browser_search
# tool, e.g. Groq with openai/gpt-oss-20b. AI_SEARCH_MODEL runs the web research step and
# falls back to AI_MODEL; the post itself is always written by AI_MODEL.
AI_WEB_SEARCH_ENABLED=false
AI_SEARCH_MODEL=
# Comma-separated category slugs that may use news/web search. Empty = none.
AI_WEB_SEARCH_CATEGORIES=tech


# Logging. Files are written to LOG_DIR/app.log and rotate at 5 MB.
LOG_LEVEL=INFO
LOG_DIR=logs

# Image storage. Keep "local" until uploads are tested. "s3" comes later.
STORAGE_BACKEND=local
WEBP_QUALITY=80
MAX_IMAGE_PIXELS=20000000
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP,GIF
PROFILE_IMAGE_SIZE=400
POST_THUMBNAIL_WIDTH=400
POST_THUMBNAIL_HEIGHT=300
POST_COVER_WIDTH=1920
POST_COVER_HEIGHT=1080
POST_CONTENT_MAX_WIDTH=1600
POST_CONTENT_MAX_HEIGHT=1200

# Leave these empty while STORAGE_BACKEND=local.
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
AWS_S3_ENDPOINT_URL=
